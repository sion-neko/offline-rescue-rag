{
  "expo": {
    "name": "防災RAG",
    "slug": "offline-rescue-rag",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sionneko.offlinerescuerag",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "救助を呼ぶときに伝える現在地（緯度経度）を表示するために使います。位置情報は端末の外に送りません。"
      }
    },
    "android": {
      "package": "com.sionneko.offlinerescuerag",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "llama.rn",
        {
          "enableEntitlements": true,
          "entitlementsProfile": ["production", "preview", "development"],
          "forceCxx20": true,
          "enableOpenCLAndHexagon": false
        }
      ],
      "expo-build-properties",
      "./plugins/with-bundled-models",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "救助を呼ぶときに伝える現在地（緯度経度）を表示するために使います。位置情報は端末の外に送りません。"
        }
      ]
    ],
    "scheme": "offlinerescuerag",
    "experiments": {
      "typedRoutes": false
    }
  }
}
